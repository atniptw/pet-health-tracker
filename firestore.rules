rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(household) {
      return isSignedIn() && request.auth.uid in household.data.memberIds;
    }

    function isAdmin(household) {
      return isSignedIn() && request.auth.uid in household.data.adminIds;
    }

    // A member can change their own symptom logs; an admin can change anyone's.
    function canChangeLog(householdId) {
      let household = get(/databases/$(database)/documents/households/$(householdId));
      return isMember(household)
        && (resource.data.createdBy == request.auth.uid || isAdmin(household));
    }

    // Fields every pet write must leave valid. Optional fields are omitted when unset.
    function isValidPet(data) {
      return data.keys().hasOnly(['name', 'species', 'breed', 'birthDate', 'sex',
          'createdAt', 'updatedAt', 'archivedAt', 'schemaVersion'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.species in ['dog', 'cat', 'other']
        && (!('breed' in data) || (data.breed is string && data.breed.size() <= 100))
        && (!('birthDate' in data)
          || (data.birthDate is string && data.birthDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (!('sex' in data) || data.sex in ['female', 'male', 'unknown'])
        && (!('archivedAt' in data) || data.archivedAt is timestamp)
        && data.updatedAt == request.time
        && data.schemaVersion == 1;
    }

    // Fields every symptom log write must leave valid. Optional fields are omitted when
    // unset. Only `other` logs store a title; catalog symptoms take theirs from the catalog.
    function isValidLog(data) {
      return data.keys().hasOnly(['symptom', 'title', 'createdBy', 'answers', 'occurredAt',
          'notes', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.symptom is string
        && data.symptom.size() > 0
        && data.symptom.size() <= 50
        && (data.symptom == 'other'
          ? (data.get('title', null) is string
            && data.title.size() > 0
            && data.title.size() <= 100)
          : !('title' in data))
        && data.createdBy is string
        && (!('answers' in data) || data.answers is map)
        && data.occurredAt is timestamp
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.updatedAt == request.time
        && data.schemaVersion == 1;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    // An invite works for 7 days after it is made.
    function isUnexpired(invite) {
      return request.time < invite.data.createdAt + duration.value(7, 'd');
    }

    // The update only adds or removes the caller in memberIds (and stamps updatedAt).
    function changesOnlyMemberIds() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // A non-admin adds their own uid to memberIds. The same batch writes their member doc
    // naming an unexpired invite for this household.
    function isJoining(householdId) {
      let uid = request.auth.uid;
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;
      let member = getAfter(/databases/$(database)/documents/households/$(householdId)/members/$(uid));
      let invite = get(/databases/$(database)/documents/invites/$(member.data.inviteId));
      return isSignedIn()
        && changesOnlyMemberIds()
        && !(uid in before)
        && after.size() == before.size() + 1
        && after.hasAll(before)
        && uid in after
        && invite.data.householdId == householdId
        && isUnexpired(invite);
    }

    // A member who isn't an admin removes their own uid from memberIds.
    function isLeaving() {
      let uid = request.auth.uid;
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;
      return isSignedIn()
        && changesOnlyMemberIds()
        && uid in before
        && !(uid in resource.data.adminIds)
        && after.size() == before.size() - 1
        && before.hasAll(after)
        && !(uid in after);
    }

    // Fields every member doc write must leave valid.
    function isValidMember(data) {
      return data.keys().hasOnly(['name', 'inviteId', 'createdAt', 'updatedAt', 'schemaVersion'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && (!('inviteId' in data) || isInviteId(data.inviteId))
        && data.updatedAt == request.time
        && data.schemaVersion == 1;
    }

    // An invite's ID is the SHA-256 hash of its code, in lowercase hex.
    function isInviteId(id) {
      return id is string && id.matches('[0-9a-f]{64}');
    }

    // A new invite, made by an admin of the household it points at.
    function isValidNewInvite(inviteId) {
      let data = request.resource.data;
      return isInviteId(inviteId)
        && data.keys().hasOnly(['householdId', 'createdBy', 'createdAt', 'schemaVersion'])
        && data.householdId is string
        && isAdmin(get(householdPath(data.householdId)))
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.schemaVersion == 1;
    }

    match /households/{householdId} {
      allow read: if isMember(resource);
      allow create: if isSignedIn()
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasOnly(
          ['name', 'memberIds', 'adminIds', 'createdAt', 'updatedAt', 'schemaVersion']);
      allow update: if (isAdmin(resource)
          && request.resource.data.adminIds.size() > 0
          && request.resource.data.memberIds.hasAll(request.resource.data.adminIds))
        || isJoining(householdId)
        || isLeaving();
      allow delete: if isAdmin(resource);

      // A member's name in this household. Kept after they leave, so their logs keep it.
      match /members/{uid} {
        allow read: if isMember(get(householdPath(householdId)));
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && uid in getAfter(householdPath(householdId)).data.memberIds
          && isValidMember(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && uid in getAfter(householdPath(householdId)).data.memberIds
          && isValidMember(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /pets/{petId} {
        allow read: if isMember(get(/databases/$(database)/documents/households/$(householdId)));
        allow create: if isAdmin(get(/databases/$(database)/documents/households/$(householdId)))
          && isValidPet(request.resource.data)
          && request.resource.data.createdAt == request.time
          && !('archivedAt' in request.resource.data);
        allow update: if isAdmin(get(/databases/$(database)/documents/households/$(householdId)))
          && isValidPet(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin(get(/databases/$(database)/documents/households/$(householdId)));

        match /symptomLogs/{logId} {
          allow read: if isMember(get(/databases/$(database)/documents/households/$(householdId)));
          allow create: if isMember(get(/databases/$(database)/documents/households/$(householdId)))
            && isValidLog(request.resource.data)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update: if canChangeLog(householdId)
            && isValidLog(request.resource.data)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if canChangeLog(householdId);
        }

        match /medications/{medId} {
          allow read: if isMember(get(/databases/$(database)/documents/households/$(householdId)));
          allow create, update, delete: if isAdmin(get(/databases/$(database)/documents/households/$(householdId)));
        }
      }
    }

    // Invites are looked up by the hash of their code, which only people given the code
    // know. Admins list their household's invites to see when the active one expires.
    match /invites/{inviteId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(get(householdPath(resource.data.householdId)));
      allow create: if isValidNewInvite(inviteId);
      // An expired code can be made again, by any household.
      allow update: if !isUnexpired(resource) && isValidNewInvite(inviteId);
      allow delete: if isAdmin(get(householdPath(resource.data.householdId)));
    }

    match /catalog/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
