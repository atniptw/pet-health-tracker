rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(household) {
      return isSignedIn() && request.auth.uid in household.data.memberIds;
    }

    function isAdmin(household) {
      return isSignedIn() && request.auth.uid in household.data.adminIds;
    }

    // A member can change their own symptom logs; an admin can change anyone's.
    function canChangeLog(householdId) {
      let household = get(/databases/$(database)/documents/households/$(householdId));
      return isMember(household)
        && (resource.data.createdBy == request.auth.uid || isAdmin(household));
    }

    match /households/{householdId} {
      allow read: if isMember(resource);
      allow create: if isSignedIn()
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasOnly(
          ['name', 'memberIds', 'adminIds', 'createdAt', 'updatedAt', 'schemaVersion']);
      allow update: if isAdmin(resource)
        && request.resource.data.adminIds.size() > 0
        && request.resource.data.memberIds.hasAll(request.resource.data.adminIds);
      allow delete: if isAdmin(resource);

      match /pets/{petId} {
        allow read: if isMember(get(/databases/$(database)/documents/households/$(householdId)));
        allow create, update, delete: if isAdmin(get(/databases/$(database)/documents/households/$(householdId)));

        match /symptomLogs/{logId} {
          allow read: if isMember(get(/databases/$(database)/documents/households/$(householdId)));
          allow create: if isMember(get(/databases/$(database)/documents/households/$(householdId)))
            && request.resource.data.createdBy == request.auth.uid;
          allow update: if canChangeLog(householdId)
            && request.resource.data.createdBy == resource.data.createdBy;
          allow delete: if canChangeLog(householdId);
        }

        match /medications/{medId} {
          allow read: if isMember(get(/databases/$(database)/documents/households/$(householdId)));
          allow create, update, delete: if isAdmin(get(/databases/$(database)/documents/households/$(householdId)));
        }
      }
    }

    match /catalog/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
